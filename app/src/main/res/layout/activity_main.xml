<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen layout -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Signed-in user's profile photo inside a green ring.
             Tapping it opens the camera to take a new photo. -->
        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:background="@drawable/profile_ring_bg"
            android:padding="5dp"
            android:src="@drawable/ic_dumbbell"
            android:contentDescription="Profile photo" />

        <!-- Hint: tapping the photo opens the camera -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="📷  Tap photo to take a new one"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Personalized welcome for the signed-in user -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Welcome!"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Workout streak, computed from the user's history in Firestore -->
        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Train smarter. Track progress. Stay consistent."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Motivation banner image, loaded from the web with Glide
             (3rd-party library) and rounded with a Glide transformation -->
        <ImageView
            android:id="@+id/imgBanner"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="24dp"
            android:scaleType="centerCrop"
            android:contentDescription="Fitness banner" />

        <!-- Daily target card — its text is loaded from Firestore
             (config/dailyTarget), so it can be changed without an app update -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/screen_panel_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTargetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🎯  Today's Target"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTargetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_gravity="center"
                android:text="Loading..."
                android:textColor="#BDBDBD"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Primary Action -->
        <Button
            android:id="@+id/btnViewWorkouts"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/primary_button_bg"
            android:text="View Workouts"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Secondary Action -->
        <Button
            android:id="@+id/btnViewProgress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/secondary_button_bg"
            android:text="View Progress"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <!-- Sign Out — quiet text-style button so it doesn't compete
             with the main actions -->
        <Button
            android:id="@+id/btnSignOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:background="@android:color/transparent"
            android:text="Sign Out"
            android:textAllCaps="false"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
